+        // Fallback for netlink message types we do not synthesize a full
+        // response for (e.g. RTM_GETROUTE=0x1a): reply with a single
+        // NLMSG_DONE so the caller sees an empty dump and keeps running,
+        // instead of throwing and dropping unidbg into the debugger.
+        final short NLMSG_DONE = 0x3;
+        ByteBuffer done = ByteBuffer.allocate(20);
+        done.order(ByteOrder.LITTLE_ENDIAN);
+        done.putInt(20);            // nlmsg_len
+        done.putShort(NLMSG_DONE);  // nlmsg_type
+        done.putShort(NLM_F_MULTI); // nlmsg_flags
