+            buffer.write(0, doneMsg, 0, doneMsg.length);
+            this.netlinkType = -1;
+            return doneMsg.length;
+        }
         throw new UnsupportedOperationException("buffer=" + buffer + ", count=" + count + ", netlinkType=0x" + Integer.toHexString(netlinkType));
     }
 
